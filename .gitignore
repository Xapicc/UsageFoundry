# No trailing slash: an isolated run installs dependencies by symlinking
# node_modules at a checkout that has none, and `node_modules/` matches
# directories only — so the link stayed untracked-but-not-ignored and
# `commitPending`'s `git add -A` would put a link pointing outside the
# repository onto the run's branch.
node_modules
# Without a trailing slash for the same reason as node_modules above: when the
# build output is redirected off the bind mount, `.next` is a symlink, and git
# does not match a symlink against a directory-only pattern.
.next
.data/

# Every .env variant is ignored, so a later .env.production or .env.local
# cannot be committed by accident. The example file is the one exception.
.env
.env.*
!.env.example

# One host's compose answers — a seccomp profile, an extra mount — which are
# not this project's defaults and must not become them. Ignored rather than
# tracked for a second reason: an isolated run's `git add -A` commits whatever
# is untracked in the checkout it was given, and this repository is one an agent
# here actually works in.
docker-compose.override.yml

*.tsbuildinfo
next-env.d.ts
.DS_Store

# Compiled output for `npm test`.
.test-build/

# The default backup destination, which compose bind-mounts at /backups. The
# directory itself is tracked (through .gitkeep) so that mount has a host
# source the container's uid can write to; what lands in it is a copy of the
# operator's own database and never belongs in the repository.
backups/*
!backups/.gitkeep

.claude/

# Database exports. Every row of the `runs` table carries the run's full prompt,
# which for the private repos this app orchestrates is a complete product brief;
# a secret scan comes back clean and the prose is the part that leaks. This
# repository is public, so an export made for analysis stays out of it.
*-dump.json
